;; babashka.http-client compatibility shim — the implementation is
;; cljrsh.http.
(ns babashka.http-client
  (:require [cljrsh.http]))

(def request cljrsh.http/request)
(def get cljrsh.http/get)
(def post cljrsh.http/post)
(def put cljrsh.http/put)
(def patch cljrsh.http/patch)
(def delete cljrsh.http/delete)
(def head cljrsh.http/head)
