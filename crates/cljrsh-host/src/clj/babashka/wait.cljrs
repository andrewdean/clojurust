;; babashka.wait compatibility veneer.
(ns babashka.wait
  (:require [cljrsh.term] [cljrsh.fs]))

(defn wait-for-port
  "Poll until host:port accepts a TCP connection.
  opts: :timeout (ms, nil = forever), :pause (ms, default 100),
  :default (returned on timeout). Returns {:host h :port p :took ms}."
  ([host port] (wait-for-port host port {}))
  ([host port {:keys [timeout pause default] :or {pause 100}}]
   (let [start (cljrsh.term/now-millis)]
     (loop []
       (cond
         (cljrsh.term/tcp-open? host port (long (or pause 100)))
         {:host host :port port :took (- (cljrsh.term/now-millis) start)}

         (and timeout (>= (- (cljrsh.term/now-millis) start) timeout))
         default

         :else
         (do (cljrsh.term/sleep-ms pause) (recur)))))))

(defn wait-for-path
  "Poll until path exists. Same opts/return shape as wait-for-port."
  ([path] (wait-for-path path {}))
  ([path {:keys [timeout pause default] :or {pause 100}}]
   (let [start (cljrsh.term/now-millis)]
     (loop []
       (cond
         (cljrsh.fs/exists? path)
         {:path path :took (- (cljrsh.term/now-millis) start)}

         (and timeout (>= (- (cljrsh.term/now-millis) start) timeout))
         default

         :else
         (do (cljrsh.term/sleep-ms pause) (recur)))))))
