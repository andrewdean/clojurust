;; babashka.process compatibility shim — the implementation is
;; cljrsh.process; this namespace re-exports it for ecosystem scripts.
(ns babashka.process
  (:require [cljrsh.process]))

(def tokenize cljrsh.process/tokenize)
(def sh cljrsh.process/sh)
(def shell cljrsh.process/shell)
(def process cljrsh.process/process)
(def wait cljrsh.process/wait)
(def alive? cljrsh.process/alive?)
(def destroy cljrsh.process/destroy)
(def destroy-tree cljrsh.process/destroy-tree)
(def check cljrsh.process/check)
