;; cljrsh.datalog — Datomic-flavored Datalog for scripts.
;;
;; Three tiers:
;;
;;   - `q` over plain collections (vectors of tuples, maps via `facts`)
;;     runs on the NATIVE engine (vendored datascript on cljrs): no pod,
;;     no network, nothing fetched.
;;   - `q` and `pull` over a durable `cljrs.dstore` db run natively too;
;;     open one with cljrs.dstore/open.
;;   - `conn`/`transact!`/`db`: the datalevin pod's durable store, kept
;;     for scripts already using it (fetched from the pod registry on
;;     first use, cached under ~/.cache/cljrsh). `q` falls back to the
;;     pod only when an input is a pod database value.
(ns cljrsh.datalog
  (:require [cljrsh.pods]
            [datascript.db]
            [datascript.query]))

(def ^:private pod-version "1.0.2")

(defonce ^:private pod
  (delay
    (cljrsh.pods/load-pod 'huahaiy/datalevin pod-version)
    ;; The pod returns Datom values under a custom transit tag; read them
    ;; as [e a v] vectors. (The handler registry lives in the babashka.pods
    ;; compat ns because the native transit decoder consults that var.)
    (require 'babashka.pods 'pod.huahaiy.datalevin)
    ((resolve 'babashka.pods/add-transit-read-handler!) "datalevin/Datom" vec)
    true))

(defn- pod-fn [name*]
  (force pod)
  (or (resolve (symbol "pod.huahaiy.datalevin" name*))
      (throw (ex-info (str "datalevin pod does not expose " name*) {:fn name*}))))

(defn- native-input?
  "True when the native engine can consume X directly: plain data, a
  collection of tuples, or anything satisfying the db protocols. Pod
  database values are opaque handles and fail all of these."
  [x]
  (or (nil? x)
      (coll? x)
      (string? x)
      (number? x)
      (keyword? x)
      (symbol? x)
      (boolean? x)
      (datascript.db/db? x)))

(defn q
  "Run a Datomic-style query. Inputs may be plain collections of tuples,
  durable cljrs.dstore dbs, or datalevin pod database values:
    (q '[:find ?n :where [?e :name ?n]] [[1 :name \"x\"]])
  Collection and dstore inputs run on the native engine; a pod database
  value routes the query to the pod."
  [query & inputs]
  (if (every? native-input? inputs)
    (apply datascript.query/q query inputs)
    (apply @(pod-fn "q") query inputs)))

(defn facts
  "Turn maps into [entity attr value] triples with generated entity ids,
  ready to pass to `q`:
    (q '[:find ?n :where [?e :kind \"Pod\"] [?e :name ?n]]
       (facts pods))"
  [maps]
  (vec (mapcat (fn [id m]
                 (for [[k v] m]
                   [id k v]))
               (range 1 (inc (count maps)))
               maps)))

(defn conn
  "Open (creating if needed) a durable pod connection at dir, with an
  optional datalevin schema map. For a native durable db see
  cljrs.dstore/open."
  ([dir] (@(pod-fn "get-conn") dir))
  ([dir schema] (@(pod-fn "get-conn") dir schema)))

(defn db [conn] (@(pod-fn "db") conn))

(defn transact! [conn txs] (@(pod-fn "transact!") conn txs))

(defn close [conn] (@(pod-fn "close") conn))

(defn entity
  "Pull a whole entity map by id (via q; the pod's entity handle does not
  cross the pod boundary)."
  [db eid]
  (into {:db/id eid}
        (map (fn [[a v]] [a v]))
        (q '[:find ?a ?v :in $ ?e :where [?e ?a ?v]] db eid)))
