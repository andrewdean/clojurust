;; cljrsh.datalog — Datomic-flavored Datalog for scripts.
;;
;; Everything runs on the native engines; there is no pod and nothing
;; is fetched:
;;
;;   - `q` over plain collections (vectors of tuples, maps via `facts`)
;;     and over in-memory / `cljrs.dstore` dbs runs on the vendored
;;     datascript engine.
;;   - `conn`/`transact!`/`db`/`q`/`pull` over a durable datalevin db
;;     run on the vendored datalevin engine against the native LMDB
;;     store (cost-based planner included).
;;
;; The native durable format is cljrs-datalog-store's own; databases
;; created by the retired datalevin pod are a different on-disk format
;; and need a re-import (q the old data out, transact! it in).
(ns cljrsh.datalog
  (:require [datalevin.db :as ddb]
            [datalevin.datom :as dd]
            [datalevin.pull-api :as dpa]
            [datalevin.query :as dq]
            [datalevin.storage :as dst]
            [datalevin.util :refer [raise]]
            [datascript.db]
            [datascript.query]))

(defn- datalevin-db? [x] (ddb/-searchable? x))

(defn q
  "Run a Datomic-style query. Inputs may be plain collections of
  tuples, durable datalevin dbs (see `conn`/`db`), cljrs.dstore dbs,
  or datascript dbs:
    (q '[:find ?n :where [?e :name ?n]] [[1 :name \"x\"]])
  Durable datalevin inputs run on the datalevin engine (with its
  cost-based planner); everything else runs on the datascript engine."
  [query & inputs]
  (if (some datalevin-db? inputs)
    (apply dq/q query inputs)
    (apply datascript.query/q query inputs)))

(defn facts
  "Turn maps into [entity attr value] triples with generated entity ids,
  ready to pass to `q`:
    (q '[:find ?n :where [?e :kind \"Pod\"] [?e :name ?n]]
       (facts pods))"
  [maps]
  (vec (mapcat (fn [id m]
                 (for [[k v] m]
                   [id k v]))
               (range 1 (inc (count maps)))
               maps)))

;; ── durable connections ──────────────────────────────────────────────

(defn conn
  "Open (creating if needed) a durable native connection at DIR, with
  an optional datalevin schema map:
    (conn \"/tmp/db\" {:friend {:db/cardinality :db.cardinality/many
                                :db/valueType :db.type/ref}})
  Returns an atom holding the current db value."
  ([dir] (conn dir nil))
  ([dir schema] (atom (ddb/empty-db dir schema))))

(defn db
  "The current database value of a connection."
  [conn]
  @conn)

(defn- tempid? [x]
  (or (and (integer? x) (neg? (long x)))
      (string? x)
      (keyword? x)))

(defn- resolve-eid
  "Resolve E to an entity id, allocating for tempids. Returns
  [eid tempids next-eid]."
  [e tempids next-eid]
  (cond
    (and (integer? e) (not (neg? (long e))))
    [(long e) tempids next-eid]

    (tempid? e)
    (if-some [known (get tempids e)]
      [known tempids next-eid]
      [next-eid (assoc tempids e next-eid) (inc (long next-eid))])

    :else
    (raise "Expected an entity id or tempid, got " e {:value e})))

(defn- entity-ops
  "[eid attr value add?] tuples for one map entity. Cardinality-many
  attrs accept collection values; nested entity maps are not supported
  (transact refs by id or tempid)."
  [d0 eid m]
  (into []
        (mapcat
          (fn [[a v]]
            (when-not (identical? a :db/id)
              (when (map? v)
                (raise "Nested entity maps are not supported; use explicit ids"
                       {:attr a :value v}))
              (if (and (ddb/multival? d0 a) (coll? v) (not (map? v)))
                (map (fn [v1] [eid a v1 true]) v)
                [[eid a v true]]))))
        m))

(defn- tx->datoms
  "Translate Datomic-style TX-DATA into datoms against D0. Supports
  [:db/add e a v], [:db/retract e a v], and entity maps; tempids
  (negative ints, strings, keywords) resolve in entity positions and
  in ref-attribute value positions. Returns {:datoms [..] :tempids {..}}."
  [d0 tx-data]
  (let [{:keys [ops tempids]}
        (loop [txs      (seq tx-data)
               tempids  {}
               next-eid (inc (long (or (ddb/max-eid d0) 0)))
               acc      []]
          (if txs
            (let [tx (first txs)]
              (cond
                (map? tx)
                (let [id (get tx :db/id)
                      [eid tempids next-eid]
                      (if (nil? id)
                        [next-eid tempids (inc (long next-eid))]
                        (resolve-eid id tempids next-eid))]
                  (recur (next txs) tempids (long next-eid)
                         (into acc (entity-ops d0 eid tx))))

                (sequential? tx)
                (let [[op e a v] tx
                      [eid tempids next-eid] (resolve-eid e tempids next-eid)]
                  (case op
                    :db/add
                    (recur (next txs) tempids (long next-eid)
                           (conj acc [eid a v true]))
                    :db/retract
                    (recur (next txs) tempids (long next-eid)
                           (conj acc [eid a v false]))
                    (raise "Unsupported tx op " op
                           {:op op :supported [:db/add :db/retract]})))

                :else
                (raise "Unsupported tx form " tx {:tx tx})))
            {:ops acc :tempids tempids}))
        resolve-v (fn [a v]
                    (if (and (ddb/ref? d0 a) (tempid? v))
                      (or (get tempids v)
                          (raise "Unresolved tempid in ref value " v
                                 {:attr a :value v}))
                      v))]
    {:datoms (mapv (fn [[e a v add?]]
                     (let [datom (dd/datom e a (resolve-v a v))]
                       (if add? datom (dd/delete datom))))
                   ops)
     :tempids tempids}))

(defn transact!
  "Apply Datomic-style TX-DATA ([:db/add e a v], [:db/retract e a v],
  entity maps with tempid allocation) to a connection. Returns
  {:db-before .. :db-after .. :tx-data .. :tempids ..}."
  [conn tx-data]
  (let [d0 @conn
        {:keys [datoms tempids]} (tx->datoms d0 tx-data)
        store (:store d0)]
    (dst/load-datoms store datoms)
    (let [d1 (ddb/new-db store)]
      (reset! conn d1)
      {:db-before d0 :db-after d1 :tx-data datoms :tempids tempids})))

(defn close
  "Close a connection (the native store needs no explicit teardown)."
  [conn]
  (dst/close (:store @conn))
  nil)

(defn pull
  "Pull PATTERN for entity EID from a durable datalevin db:
    (pull (db conn) [:name {:friend [:name]}] 1)"
  [db pattern eid]
  (dpa/pull db pattern eid))

(defn entity
  "Pull a whole entity map by id."
  [db eid]
  (if (datalevin-db? db)
    (dpa/pull db '[*] eid)
    (into {:db/id eid}
          (map (fn [[a v]] [a v]))
          (q '[:find ?a ?v :in $ ?e :where [?e ?a ?v]] db eid))))
