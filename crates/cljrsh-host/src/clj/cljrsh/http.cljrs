;; cljrsh.http — the primary HTTP client API (babashka.http-client is a
;; compatibility shim over this namespace; `request*` is the native
;; plan-executing primitive).
;;
;; request, get, post, put, patch, delete, head with :headers,
;; :query-params, :form-params, :body, :basic-auth, :timeout (ms),
;; :follow-redirects, and :throw (default true — non-2xx/3xx throws ex-info
;; with the response as data, matching babashka.http-client).
(ns cljrsh.http)

(defn- normalize-opts [opts]
  (let [opts (if (:timeout opts)
               (-> opts (assoc :timeout-ms (:timeout opts)) (dissoc :timeout))
               opts)]
    opts))

(defn request
  "Perform a request. opts must include :url (and usually :method)."
  [opts]
  (let [throw? (clojure.core/get opts :throw true)
        resp (cljrsh.http/request* (dissoc (normalize-opts opts) :throw))]
    (if (and throw? (>= (:status resp) 400))
      (throw (ex-info (str "Exceptional status code: " (:status resp)) resp))
      resp)))

(defn- verb [method]
  (fn f
    ([url] (f url {}))
    ([url opts] (request (assoc opts :method method :url url)))))

(def get (verb :get))
(def post (verb :post))
(def put (verb :put))
(def patch (verb :patch))
(def delete (verb :delete))
(def head (verb :head))
